rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /chalecos/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Catálogo de lanas (uso interno del bot; lo edita el admin). Mismo acceso que chalecos.
    match /lanas/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stats/{doc} {
      allow read: if true;
      allow write: if true;
    }

    match /visits/{doc} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // ===== RESEÑAS =====
    // Invitaciones (ID del documento = token)
    match /invitaciones/{token} {
      allow get: if true;                                   // /resena valida el token por ID
      allow list, create, delete: if request.auth != null;  // solo el admin
      // Marcar usada: el admin, o el cliente al enviar (solo flip false->true Y solo si
      // en la misma transacción se crea la reseña pendiente).
      allow update: if request.auth != null
        || (resource.data.usado == false
            && request.resource.data.usado == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado'])
            && getAfter(/databases/$(database)/documents/resenas/$(token)).data.estado == 'pendiente');
    }

    // Reseñas (ID del documento = token)
    match /resenas/{token} {
      allow read: if resource.data.estado == 'publicada' || request.auth != null;
      allow create: if resenaValida(token);
      allow update, delete: if request.auth != null;        // moderar (publicar / borrar)
    }

    // Sugerencias privadas (feedback interno) — ID = token. SOLO el admin las lee. Nunca son públicas.
    match /sugerencias/{token} {
      allow read: if request.auth != null;                  // solo admin
      allow create: if request.resource.data.keys().hasOnly(['texto','fecha'])
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1500
        && request.resource.data.fecha == request.time
        && getAfter(/databases/$(database)/documents/resenas/$(token)).data.estado == 'pendiente';
      allow update, delete: if request.auth != null;        // admin (se borra junto con la reseña)
    }

    // Pedidos / seguimiento de clientes (señas, estados). Solo el admin: /carga está detrás de login.
    match /pedidos/{id} {
      allow read, write: if request.auth != null;
    }

    // Mapa del país. `geo` es un doc por provincia con lo que devuelve la API de Meta
    // (gasto, charlas, costo por charla); lo escribe n8n con el usuario del panel.
    // `hallazgos` es la bitácora de pruebas que se ve en /carga. Ninguna de las dos es
    // pública: dicen dónde se pauta y cuánto sale.
    match /geo/{provincia} {
      allow read, write: if request.auth != null;
    }

    match /hallazgos/{id} {
      allow read, write: if request.auth != null;
    }

    // Configuración interna. Hoy: config/asistente, el manual que usa /responder.
    // Nunca público: tiene la estrategia de venta completa.
    match /config/{doc} {
      allow read, write: if request.auth != null;
    }

    // Registro de lo que el asistente sugirió y se copió. Es el material para
    // mejorar el manual: qué se usó tal cual y qué hubo que corregir.
    match /asistente_uso/{id} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    function resenaValida(token) {
      let inv = /databases/$(database)/documents/invitaciones/$(token);
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre','apellido','ciudad','estrellas','texto','fotoURL','estado','fecha','token'])
        && d.estado == 'pendiente' && d.token == token
        && d.estrellas is int && d.estrellas >= 1 && d.estrellas <= 5
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.apellido is string && d.apellido.size() <= 80
        && d.ciudad is string && d.ciudad.size() > 0 && d.ciudad.size() <= 80
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1500
        && d.fotoURL is string && (d.fotoURL == '' || d.fotoURL.matches('https://res\\.cloudinary\\.com/dgl2mizsf/image/upload/.*'))
        && d.fecha == request.time
        && exists(inv) && get(inv).data.usado == false
        && getAfter(inv).data.usado == true;   // consume la invitación en la MISMA transacción
    }
  }
}
